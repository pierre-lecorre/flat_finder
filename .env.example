# Flat Finder — Environment Configuration
# Copy this file to .env and adjust values.

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1

# Paths (relative to project root or absolute)
DATA_DIR=data
CONFIGS_DIR=configs

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/flat_finder.log

# Browser
BROWSER_HEADLESS=false
BROWSER_STATE_DIR=data/browser_state

# Scraping
DEFAULT_MIN_DELAY_MS=1000
DEFAULT_MAX_DELAY_MS=3000
